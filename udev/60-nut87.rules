# WEIKAV NUT87 — let an unprivileged user open the Device's hidraw interface.
#
# Install:
#   sudo cp udev/60-nut87.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger
# then re-plug the keyboard.
#
# TAG+="uaccess" grants access to the logged-in seat user; MODE="0666" also
# covers non-seat sessions (ssh), matching docs/capture.md.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0c45", TAG+="uaccess", MODE="0666"
